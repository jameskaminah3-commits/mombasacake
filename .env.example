# Copy this file to .env.local for local development.
#
# Supabase:
# Use the Postgres connection string from Supabase Project Settings > Database.
# The pooler URL is usually best for deployed apps. Keep sslmode=require.
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require"

# Supabase storage
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_MEDIA_BUCKET="cake-media"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
VITE_SUPABASE_MEDIA_BUCKET="cake-media"
VITE_SUPABASE_MAX_IMAGE_BYTES=1500000

# Email
# Used for admin password resets and new order notifications.
RESEND_API_KEY="YOUR_RESEND_API_KEY"
# The sender's domain must be verified in Resend.
RESEND_FROM_EMAIL="Channah Cakes <no-reply@channahcakes.co.ke>"

# Local ports
PORT=3001
API_PORT=3001
WEB_PORT=5173
BASE_PATH=/
# The shop's public address, used in admin password-reset links and for M-Pesa callbacks.
# In production use the live domain, e.g. https://www.channahcakes.co.ke
# (The shop calls the API on whatever address it was opened from, so no API URL setting is needed.)
PUBLIC_APP_URL="http://localhost:5173"

# Auth
SESSION_SECRET="change-this-to-a-long-random-string"

# Optional local admin seeding helper. Login itself reads admins only from Supabase.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-private-password"
SEED_ADMIN_NAME="Admin"

# Optional M-Pesa settings. Without these, dev checkout returns a mock response.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
